# ── 백엔드 환경변수 템플릿 ────────────────────────────────────────────────────
# 복사해서 .env 로 만들고 실제 값을 채우세요
# cp .env.example .env

# DB (Railway MariaDB 자동 제공 값을 붙여넣으세요)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=railway

# 서버 포트 (Railway가 PORT 환경변수를 자동 주입 — 건드리지 마세요)
PORT=3001
NODE_ENV=production

# CORS 허용 origin (Vercel 도메인, 쉼표로 여러 개 가능)
# 예) ALLOWED_ORIGINS=https://portfolio-doctor.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://your-app.vercel.app
